# ============================================================
# GlucoseIQ — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Neon PostgreSQL ---
# Get this from your Neon project dashboard → Connection Details → "Connection string"
# For Neon, use the standard postgres:// connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL is the same for Neon (no pgbouncer proxy needed with @prisma/adapter-pg)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# The canonical URL of your app (no trailing slash)
# For local dev: http://localhost:3000
# For production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
